# Copy to .env and adjust. All values here are fake / local-only.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# How long an Idempotency-Key is remembered
IDEMPOTENCY_KEY_TTL_HOURS=24

# Requests per minute per user
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120

# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres on 5432)
POSTGRES_DB=quota_manager
POSTGRES_USER=quota
POSTGRES_PASSWORD=quota
POSTGRES_PORT=5433
DATABASE_URL=postgres://quota:quota@localhost:5433/quota_manager

# Host port 6380 to avoid clashing with a local Redis on 6379
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
# Tests use their own Redis database and clear it between tests
TEST_REDIS_URL=redis://localhost:6380/15
