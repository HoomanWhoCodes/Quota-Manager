# Copy to .env and adjust. All values here are fake / local-only.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# How long an Idempotency-Key is remembered
IDEMPOTENCY_KEY_TTL_HOURS=24

# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres on 5432)
POSTGRES_DB=quota_manager
POSTGRES_USER=quota
POSTGRES_PASSWORD=quota
POSTGRES_PORT=5433
DATABASE_URL=postgres://quota:quota@localhost:5433/quota_manager
